<Window x:Class="SEMANA05_EXAM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SEMANA05_EXAM"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Orientation="Vertical" Margin="10">

            <!-- Botones en una fila -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                <Button Name="btn1" Content="Button 1" Width="100" Height="30" Margin="5" Click="btn1_Click"/>
                <Button Name="btn2" Content="Button 2" Width="100" Height="30" Margin="5" Click="btn1_Click2"/>
                <Button Name="btn3" Content="Button 3" Width="100" Height="30" Margin="5" Click="btn1_Click3"/>
            </StackPanel>

            <!-- DataGrid abajo -->
            <DataGrid x:Name="dgProductos" Height="300"/>

        </StackPanel>



    </Grid>
</Window>
